# .env.example — Variables de entorno para despliegue DMZ
# ============================================================
# INSTRUCCIONES:
#   1. Copia: cp .env.example .env
#   2. Rellena los valores reales
#   3. NUNCA subas .env a GitHub
# ============================================================

# ---- Dominio de la VM en el DMZ  ----
# Nombre DNS completo de la máquina virtual
DOMAIN=api.vvalero.dev

# ---- Credenciales TTN ----
# TTN Console → Applications → API keys → Generate
# Permiso necesario: "Write downlink application traffic"
TTN_APP_ID=casa-inteligente-iot
TTN_API_KEY=NNSXS.TU_API_KEY_AQUI

# ---- End device IDs en TTN (tal como aparecen en TTN Console) ----
SENSOR_S1_DEVICE=lopy4-salon
SENSOR_S2_DEVICE=lopy4-dormitorio
SENSOR_S3_DEVICE=lopy4-exterior
